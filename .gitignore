# ESP-IDF build artifacts
build/
uploader/build/

# Generated sdkconfig (regenerated from sdkconfig.defaults)
sdkconfig
sdkconfig.old
uploader/sdkconfig
uploader/sdkconfig.old
dependencies.lock

# Managed components
managed_components/

# Python bytecode
__pycache__/
*.pyc

# Secure boot signing key — dev-only, never commit. Generate your own with:
#   espsecure.py generate_signing_key secure_boot_signing_key.pem
secure_boot_signing_key.pem

# Vendor payload signing key — private, never commit. Generate with:
#   python3 tools/generate_vendor_key.py
payload_signing_key.pem

# Signed payload bundles — generated locally, never commit. Generate with:
#   python3 tools/generate_signed_payload.py <micropython.bin> seedsigner_esp32p4.bin
seedsigner_*.bin
