 static const char *TAG = "SEEDSIGNER_LOADER";
 
+#ifdef EMU_FLASH_PAYLOAD
+// EMULATION-ONLY (scratch copy): the signed bundle is baked into raw flash at
+// EMU_FLASH_PAYLOAD_OFFSET (Specter header) so the ESP image inside lands at
+// 0x140000 (64KB-aligned, as the MMU mapping requires). Reads the bundle via
+// the ROM SPI-flash function instead of touching the (unemulated) SD card.
+#define EMU_FLASH_PAYLOAD_OFFSET 0x13FF00
+#include "esp_rom_spiflash.h"
+#include "bl_section.h"
+
+static uint8_t *load_firmware_from_flash_emu(size_t *out_size)
+{
+    bl_section_t main_hdr;
+    if (esp_rom_spiflash_read(EMU_FLASH_PAYLOAD_OFFSET,
+                              (uint32_t *)&main_hdr,
+                              sizeof(main_hdr)) != ESP_OK) {
+        ESP_LOGE(TAG, "EMU: failed to read bundle header from flash 0x%X. Halting.",
+                 EMU_FLASH_PAYLOAD_OFFSET);
+        return NULL;
+    }
+    if (main_hdr.magic != BL_SECT_MAGIC) {
+        ESP_LOGE(TAG, "EMU: no Specter header at flash 0x%X (magic 0x%08lX). Halting.",
+                 EMU_FLASH_PAYLOAD_OFFSET, (unsigned long)main_hdr.magic);
+        return NULL;
+    }
+    bl_section_t sig_hdr;
+    uint32_t sig_off = EMU_FLASH_PAYLOAD_OFFSET + sizeof(bl_section_t) + main_hdr.pl_size;
+    if (esp_rom_spiflash_read(sig_off, (uint32_t *)&sig_hdr, sizeof(sig_hdr)) != ESP_OK) {
+        ESP_LOGE(TAG, "EMU: failed to read signature header. Halting.");
+        return NULL;
+    }
+    if (sig_hdr.magic != BL_SECT_MAGIC || !blsect_is_signature(&sig_hdr)) {
+        ESP_LOGE(TAG, "EMU: signature section missing or invalid. Halting.");
+        return NULL;
+    }
+    size_t total = sizeof(bl_section_t) + main_hdr.pl_size
+                 + sizeof(bl_section_t) + sig_hdr.pl_size;
+    if (total == 0 || total > MAX_FIRMWARE_SIZE) {
+        ESP_LOGE(TAG, "EMU: invalid bundle size %u. Halting.", (unsigned)total);
+        return NULL;
+    }
+    uint8_t *psram_buf = heap_caps_aligned_alloc(65536, total, MALLOC_CAP_SPIRAM);
+    if (!psram_buf) {
+        ESP_LOGE(TAG, "EMU: PSRAM alloc failed (%u bytes). Halting.", (unsigned)total);
+        return NULL;
+    }
+    if (esp_rom_spiflash_read(EMU_FLASH_PAYLOAD_OFFSET,
+                              (uint32_t *)psram_buf, total) != ESP_OK) {
+        ESP_LOGE(TAG, "EMU: failed to read bundle from flash. Halting.");
+        free(psram_buf);
+        return NULL;
+    }
+    *out_size = total;
+    ESP_LOGI(TAG, "EMU: loaded %u bundle bytes from flash 0x%X (no SD card)",
+             (unsigned)total, EMU_FLASH_PAYLOAD_OFFSET);
+    return psram_buf;
+}
+#endif
