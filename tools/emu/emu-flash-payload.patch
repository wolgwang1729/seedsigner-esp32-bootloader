+
+# EMULATION-ONLY (scratch copy, never merged upstream): read the signed payload
+# from a raw flash offset instead of the SD card, so stateless boot can be
+# tested in esp-emu, which models no SD card. Enabled with EMU_FLASH_PAYLOAD=1
+# in the environment at configure time.
+if("$ENV{EMU_FLASH_PAYLOAD}" STREQUAL "1")
+    message(STATUS "Seedsigner loader: EMU_FLASH_PAYLOAD enabled (no SD card)")
+    target_compile_definitions(${COMPONENT_LIB} PRIVATE EMU_FLASH_PAYLOAD=1)
+    if(NOT "$ENV{EMU_NO_SKIP_ANTI_PHISH}" STREQUAL "1")
+        message(STATUS "Seedsigner loader: EMU_SKIP_ANTI_PHISH enabled (fast emulation)")
+        target_compile_definitions(${COMPONENT_LIB} PRIVATE EMU_SKIP_ANTI_PHISH=1)
+    endif()
+endif()
